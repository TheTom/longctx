#!/usr/bin/env python3
"""One-command launcher: TheTom/llama-cpp-turboquant + longctx-svc.

Wraps `llama-server` so users get retrieval with a single flag. The
wrapper:
  1. Spawns llama-server bound to a free internal port
  2. Spawns longctx-svc on the user's --port with --upstream pointing
     at the internal port
  3. Tears both down on exit

Usage:
    llama-server-longctx -m model.gguf --port 8000 --enable-longctx
        [usual llama-server args...]

Without --enable-longctx, the wrapper just execs llama-server unchanged
— zero overhead, optional everywhere.

Env knobs:
    LLAMA_SERVER_BIN  full path to llama-server binary
                      (default: searches PATH, then
                       /Users/tom/local_llms/llama.cpp/build/bin/llama-server)
    LONGCTX_ENABLE=1  same effect as --enable-longctx
"""
from __future__ import annotations

import argparse
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request


def _llama_server_path() -> str | None:
    env = os.environ.get("LLAMA_SERVER_BIN")
    if env and os.path.isfile(env):
        return env
    p = shutil.which("llama-server")
    if p:
        return p
    fallback = "/Users/tom/local_llms/llama.cpp/build/bin/llama-server"
    if os.path.isfile(fallback):
        return fallback
    return None


def _wait_http(url: str, timeout: float = 60.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2.0):
                return True
        except (urllib.error.URLError, ConnectionError, OSError):
            pass
        time.sleep(0.5)
    return False


def _kill(p: subprocess.Popen) -> None:
    if p.poll() is not None:
        return
    try:
        if hasattr(os, "killpg"):
            os.killpg(os.getpgid(p.pid), signal.SIGTERM)
        else:
            p.terminate()
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            if hasattr(os, "killpg"):
                os.killpg(os.getpgid(p.pid), signal.SIGKILL)
            else:
                p.kill()
    except (ProcessLookupError, PermissionError):
        pass


def _extract_port(args: list[str]) -> tuple[int, list[str]]:
    """Pull --port out of args; default 8080 (llama-server's default)."""
    out: list[str] = []
    port = 8080
    skip = False
    for i, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a == "--port":
            if i + 1 < len(args):
                try:
                    port = int(args[i + 1])
                except ValueError:
                    pass
                skip = True
            continue
        if a.startswith("--port="):
            try:
                port = int(a.split("=", 1)[1])
            except ValueError:
                pass
            continue
        out.append(a)
    return port, out


def main(argv: list[str] | None = None) -> int:
    raw = list(argv if argv is not None else sys.argv[1:])

    enable = os.environ.get("LONGCTX_ENABLE", "").lower() in ("1", "true", "yes")
    if "--enable-longctx" in raw:
        enable = True
        raw.remove("--enable-longctx")
    if "--no-enable-longctx" in raw:
        enable = False
        raw.remove("--no-enable-longctx")

    bin_path = _llama_server_path()
    if bin_path is None:
        sys.stderr.write(
            "llama-server-longctx: llama-server binary not found. "
            "Set LLAMA_SERVER_BIN or add to PATH.\n"
        )
        return 2

    if not enable:
        # Pure passthrough — no wrapper overhead. Optional everywhere.
        os.execvp(bin_path, [bin_path, *raw])
        return 0  # unreachable

    try:
        from longctx_svc.sidecar import (
            PortInUseError,
            pick_port,
            spawn_sidecar,
        )
    except ImportError:
        sys.stderr.write(
            "llama-server-longctx: --enable-longctx requires "
            "`pip install longctx-svc`\n"
        )
        return 2

    user_port, llama_args = _extract_port(raw)
    try:
        pick_port(preferred=user_port)
    except PortInUseError as exc:
        sys.stderr.write(f"llama-server-longctx: {exc}\n")
        return 1
    internal_port = pick_port()

    print(
        f"llama-server-longctx: --enable-longctx set; binding llama-server "
        f"internally to :{internal_port}, longctx-svc on user :{user_port}"
    )

    upstream = f"http://127.0.0.1:{internal_port}"
    cmd = [bin_path, *llama_args, "--port", str(internal_port)]
    llama_proc = subprocess.Popen(
        cmd,
        preexec_fn=os.setsid if hasattr(os, "setsid") else None,
    )
    sidecar = None

    def _shutdown(*_a: object) -> None:
        if sidecar is not None:
            sidecar.stop()
        _kill(llama_proc)

    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            signal.signal(sig, lambda *_: (_shutdown(), sys.exit(0)))
        except ValueError:
            pass

    try:
        # Wait for llama-server first
        if not _wait_http(f"{upstream}/v1/models", timeout=180.0):
            sys.stderr.write(
                "llama-server-longctx: llama-server did not become healthy "
                "in 180s; check stderr above.\n"
            )
            _shutdown()
            return 1
        # Then spawn sidecar
        try:
            sidecar = spawn_sidecar(
                port=user_port,
                extra_env={"LONGCTX_UPSTREAM": upstream},
                boot_timeout=30.0,
            )
        except (PortInUseError, RuntimeError) as exc:
            sys.stderr.write(
                f"llama-server-longctx: longctx-svc failed: {exc}\n"
            )
            _shutdown()
            return 1
        print(
            f"llama-server-longctx: ready. POST chat/completions to "
            f"{sidecar.url}/v1/chat/completions"
        )
        # Block until llama-server exits (or we're killed)
        rc = llama_proc.wait()
        sidecar.stop()
        return rc
    finally:
        _shutdown()


if __name__ == "__main__":
    sys.exit(main())
